<?xml version='1.0' encoding='utf-8'?>
<VTKFile type="ImageData" version="0.1" byte_order="LittleEndian" header_type="UInt32" compressor="vtkZLibDataCompressor">
  <RD format_version="6">
    <description />
    <rule name="Brusselator" type="formula" wrap="1" neighborhood_type="vertex">
      <param name="timestep">0.002500</param>
      <param name="D_a">0.952455</param>
      <param name="D_b">8.857640</param>
      <param name="alpha">0.679295</param>
      <param name="beta">3.650916</param>
      <param name="dx">1.000000</param>
      <formula number_of_chemicals="2" block_size_x="4" block_size_y="1" block_size_z="1" accuracy="high">delta_a = D_a * laplacian_a + alpha - (beta + 1) * a + a * a * b;
delta_b = D_b * laplacian_b + beta * a - a * a * b;</formula>
    </rule>
    <render_settings>
      <active_chemical value="b" />
      <show_displacement_mapped_surface value="false" />
    </render_settings>
  </RD>
  <ImageData WholeExtent="0 127 0 127 0 0" Origin="0 0 0" Spacing="1 1 1" Direction="1 0 0 0 1 0 0 0 1">
    <Piece Extent="0 127 0 127 0 0">
      <PointData Scalars="a">
        <DataArray type="Float32" Name="a" format="binary" RangeMin="0.2408987283706665" RangeMax="1.1101443767547607">
        
      </DataArray>
        <DataArray type="Float32" Name="b" format="binary" RangeMin="3.27458119392395" RangeMax="4.011603832244873">
        
      </DataArray>
      </PointData>
      <CellData>
    </CellData>
    </Piece>
  </ImageData>
</VTKFile>