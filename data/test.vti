<?xml version="1.0"?>
<VTKFile type="ImageData" version="0.1" byte_order="LittleEndian" header_type="UInt32" compressor="vtkZLibDataCompressor">
  <RD format_version="6">
    <description/>
    <rule name="Brusselator" type="formula" wrap="1" neighborhood_type="vertex">
      <param name="timestep">
        0.002500
      </param>
      <param name="D_a">
        1.000000
      </param>
      <param name="D_b">
        8.000000
      </param>
      <param name="alpha">
        1.500000
      </param>
      <param name="beta">
        10.500000
      </param>
      <param name="dx">
        0.500000
      </param>
      <formula number_of_chemicals="2" block_size_x="4" block_size_y="1" block_size_z="1" accuracy="high">
        delta_a = D_a * laplacian_a + alpha - (beta + 1) * a + a * a * b;
        delta_b = D_b * laplacian_b + beta * a - a * a * b;
      </formula>
    </rule>
    <initial_pattern_generator apply_when_loading="false" zero_first="true"/>
    <render_settings>
      <surface_color r="1" g="1" b="1"/>
      <colormap value="spectral"/>
      <color_low r="0" g="0" b="1"/>
      <color_high r="1" g="0" b="0"/>
      <show_color_scale value="true"/>
      <show_multiple_chemicals value="true"/>
      <active_chemical value="b"/>
      <low value="0"/>
      <high value="15"/>
      <vertical_scale_1D value="30"/>
      <vertical_scale_2D value="15"/>
      <contour_level value="0.25"/>
      <cap_contour value="true"/>
      <invert_contour_cap value="false"/>
      <use_wireframe value="false"/>
      <show_cell_edges value="false"/>
      <show_bounding_box value="true"/>
      <show_chemical_label value="true"/>
      <slice_3D value="true"/>
      <slice_3D_axis value="z"/>
      <slice_3D_position value="0.5"/>
      <show_displacement_mapped_surface value="false"/>
      <color_displacement_mapped_surface value="false"/>
      <use_image_interpolation value="true"/>
      <timesteps_per_render value="100"/>
      <show_phase_plot value="false"/>
      <phase_plot_x_axis value="a"/>
      <phase_plot_y_axis value="b"/>
      <phase_plot_z_axis value="c"/>
      <plot_ab_orthogonally value="false"/>
    </render_settings>
  </RD>
  <ImageData WholeExtent="0 127 0 127 0 0" Origin="0 0 0" Spacing="1 1 1">
  <Piece Extent="0 127 0 127 0 0">
    <PointData>
      <DataArray type="Float32" Name="a" format="binary" RangeMin="0.13654544949531555" RangeMax="11.828980445861816">
        
      </DataArray>
      <DataArray type="Float32" Name="b" format="binary" RangeMin="1.0584239959716797" RangeMax="3.6915900707244873">
        
      </DataArray>
    </PointData>
    <CellData>
    </CellData>
  </Piece>
  </ImageData>
</VTKFile>
